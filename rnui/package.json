{
  "name": "@xlong/rnui",
  "version": "1.0.8",
  "description": "xiao long wang React Native UI component",
  "main": "lib/index.js",
  "module": "es/index.js",
  "typings": "types/index.d.ts",
  "scripts": {
    "build": "npm run clean && npm run build:es && npm run build:cjs && npm run build:types",
    "build:cjs": " babel src -d lib --extensions \".ts,.tsx\" --config-file ../bable.react.lib.js",
    "build:es": "babel src -d es --extensions \".ts,.tsx\" --config-file  ../bable.react.es.js",
    "build:types": "tsc --outDir types -d --emitDeclarationOnly",
    "clean": "rimraf es lib types"
  },
  "author": "xiao long wang",
  "license": "ISC",
  "files": [
    "es",
    "lib",
    "types"
  ],
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.74.5",
    "react-native-safe-area-context": ">=4.10.5"
  }
}
